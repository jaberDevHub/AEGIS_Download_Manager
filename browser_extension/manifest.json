{
  "manifest_version": 3,
  "name": "Aegis Download Manager",
  "version": "1.2.0",
  "description": "Smart stream sniffer & floating video download panel for Aegis Download Manager.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "storage",
    "webRequest",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*", "<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "match_about_blank": true,
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Aegis Download Manager",
    "default_popup": "popup.html"
  }
}
